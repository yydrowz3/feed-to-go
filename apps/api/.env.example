# Set dev to allow CORS from any origin; all other values use WEB_URL.
APP_ENV=
PORT=
# Allowed frontend origin outside dev (scheme + host + port, no path or trailing slash).
# Defaults to http://localhost:5173 when unset or empty.
WEB_URL=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# disable, allow, prefer, require, verify-ca, verify-full
DB_SSLMODE=
# disable, prefer, require
DB_CHANNEL_BINDING=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
# Set true for Upstash or other Redis instances requiring TLS.
# Use the native Redis hostname/port/password, not the REST URL/token.
REDIS_TLS=false

# Optional full CloudAMQP connection URI; overrides the fields below.
AMQP_URL=
AMQP_HOST=
AMQP_PORT=
AMQP_USER=
AMQP_PASSWORD=
# CloudAMQP: use the vhost from the connection URI, not the default /.
AMQP_VHOST=/
# amqps uses TLS, normally on port 5671; plain amqp normally uses 5672.
AMQP_TLS=false

JWT_SECRET=
